\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {ReBel overview.} Three innovations work in a closed loop: structured belief prompting produces JSON-formatted belief states that serve as both the grouping signal for HiBO and the basis for the intrinsic reward curriculum. HiBO recovers step-level learning signal from singleton observation groups. The adaptive curriculum decays differentially across reward components as the agent's competence grows.\relax }}{4}{figure.caption.11}\protected@file@percent }
\newlabel{fig:overview}{{2}{4}{\textbf {ReBel overview.} Three innovations work in a closed loop: structured belief prompting produces JSON-formatted belief states that serve as both the grouping signal for HiBO and the basis for the intrinsic reward curriculum. HiBO recovers step-level learning signal from singleton observation groups. The adaptive curriculum decays differentially across reward components as the agent's competence grows.\relax }{figure.caption.11}{}}
